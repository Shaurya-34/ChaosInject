{
  "$defs": {
    "PlanEstimate": {
      "additionalProperties": false,
      "properties": {
        "captured_at": {
          "format": "date-time",
          "title": "Captured At",
          "type": "string"
        },
        "estimated_output_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Estimated Output Bytes"
        },
        "estimated_rows": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Estimated Rows"
        },
        "estimated_width_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Estimated Width Bytes"
        },
        "node_categories": {
          "items": {
            "type": "string"
          },
          "title": "Node Categories",
          "type": "array"
        },
        "plan_source": {
          "enum": [
            "explain_json",
            "fixture",
            "unavailable"
          ],
          "title": "Plan Source",
          "type": "string"
        },
        "planner_cost": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Planner Cost"
        },
        "request_id": {
          "title": "Request Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "stats_quality": {
          "enum": [
            "fresh",
            "stale",
            "unknown",
            "fixture"
          ],
          "title": "Stats Quality",
          "type": "string"
        },
        "uncertainty": {
          "items": {
            "type": "string"
          },
          "title": "Uncertainty",
          "type": "array"
        }
      },
      "required": [
        "request_id",
        "captured_at",
        "plan_source",
        "estimated_rows",
        "estimated_width_bytes",
        "estimated_output_bytes",
        "planner_cost",
        "node_categories",
        "stats_quality",
        "uncertainty"
      ],
      "title": "PlanEstimate",
      "type": "object"
    },
    "Prediction": {
      "additionalProperties": false,
      "properties": {
        "cold_start": {
          "title": "Cold Start",
          "type": "boolean"
        },
        "drift_status": {
          "enum": [
            "cold_start",
            "stable",
            "drift",
            "unknown"
          ],
          "title": "Drift Status",
          "type": "string"
        },
        "duration_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Duration Ms"
        },
        "learner_version": {
          "title": "Learner Version",
          "type": "string"
        },
        "pre_update_sample_count": {
          "minimum": 0,
          "title": "Pre Update Sample Count",
          "type": "integer"
        },
        "quality_note": {
          "title": "Quality Note",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "duration_ms",
        "learner_version",
        "pre_update_sample_count",
        "cold_start",
        "drift_status",
        "quality_note"
      ],
      "title": "Prediction",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "decision": {
      "enum": [
        "ALLOW",
        "WARN",
        "BLOCK"
      ],
      "title": "Decision",
      "type": "string"
    },
    "decision_id": {
      "title": "Decision Id",
      "type": "string"
    },
    "executed": {
      "const": false,
      "default": false,
      "title": "Executed",
      "type": "boolean"
    },
    "intent_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Intent Id"
    },
    "plan_estimate": {
      "anyOf": [
        {
          "$ref": "#/$defs/PlanEstimate"
        },
        {
          "type": "null"
        }
      ]
    },
    "policy_version": {
      "title": "Policy Version",
      "type": "string"
    },
    "prediction": {
      "anyOf": [
        {
          "$ref": "#/$defs/Prediction"
        },
        {
          "type": "null"
        }
      ]
    },
    "reasons": {
      "items": {
        "type": "string"
      },
      "title": "Reasons",
      "type": "array"
    },
    "recommendations": {
      "items": {
        "type": "string"
      },
      "title": "Recommendations",
      "type": "array"
    },
    "request_id": {
      "title": "Request Id",
      "type": "string"
    },
    "rule_ids": {
      "items": {
        "type": "string"
      },
      "title": "Rule Ids",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "enum": [
        "live",
        "fixture",
        "replay"
      ],
      "title": "Source",
      "type": "string"
    },
    "state_id": {
      "title": "State Id",
      "type": "string"
    }
  },
  "required": [
    "source",
    "decision_id",
    "request_id",
    "decision",
    "rule_ids",
    "policy_version",
    "state_id",
    "plan_estimate",
    "prediction",
    "reasons",
    "recommendations"
  ],
  "title": "QueryDecision",
  "type": "object"
}
