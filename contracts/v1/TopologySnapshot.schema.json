{
  "$defs": {
    "TopologyEdge": {
      "additionalProperties": false,
      "properties": {
        "caller": {
          "title": "Caller",
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "dependency": {
          "title": "Dependency",
          "type": "string"
        },
        "protocol": {
          "title": "Protocol",
          "type": "string"
        },
        "provenance": {
          "title": "Provenance",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "caller",
        "dependency",
        "protocol",
        "provenance",
        "confidence"
      ],
      "title": "TopologyEdge",
      "type": "object"
    },
    "TopologyNode": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "desired_replicas": {
          "minimum": 0,
          "title": "Desired Replicas",
          "type": "integer"
        },
        "kind": {
          "enum": [
            "Deployment",
            "StatefulSet",
            "Service",
            "Pod"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "ports": {
          "items": {
            "type": "integer"
          },
          "title": "Ports",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "selector": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Selector",
          "type": "object"
        },
        "stateful": {
          "title": "Stateful",
          "type": "boolean"
        },
        "target_id": {
          "title": "Target Id",
          "type": "string"
        },
        "uid": {
          "title": "Uid",
          "type": "string"
        }
      },
      "required": [
        "target_id",
        "name",
        "kind",
        "uid",
        "selector",
        "ports",
        "desired_replicas",
        "stateful",
        "confidence"
      ],
      "title": "TopologyNode",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "edges": {
      "items": {
        "$ref": "#/$defs/TopologyEdge"
      },
      "title": "Edges",
      "type": "array"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "graph_id": {
      "title": "Graph Id",
      "type": "string"
    },
    "manual_corrections": {
      "items": {
        "type": "string"
      },
      "title": "Manual Corrections",
      "type": "array"
    },
    "namespace": {
      "title": "Namespace",
      "type": "string"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/TopologyNode"
      },
      "title": "Nodes",
      "type": "array"
    },
    "sandbox_id": {
      "title": "Sandbox Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "enum": [
        "live",
        "fixture",
        "replay"
      ],
      "title": "Source",
      "type": "string"
    },
    "upstream_sha": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Upstream Sha"
    }
  },
  "required": [
    "source",
    "graph_id",
    "upstream_sha",
    "generated_at",
    "sandbox_id",
    "namespace",
    "nodes",
    "edges",
    "manual_corrections"
  ],
  "title": "TopologySnapshot",
  "type": "object"
}
