    },
    "model_limit_bytes": {
      "minimum": 0,
      "title": "Model Limit Bytes",
      "type": "integer"
    },
    "pending_count": {
      "maximum": 128,
      "minimum": 0,
      "title": "Pending Count",
      "type": "integer"
    },
