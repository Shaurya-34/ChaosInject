{
  "$defs": {
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "evidence_hash": {
          "title": "Evidence Hash",
          "type": "string"
        },
        "pointer": {
          "title": "Pointer",
          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "evidence_hash",
        "pointer"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "priority": {
          "maximum": 5,
          "minimum": 1,
          "title": "Priority",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "predicted",
            "supported_in_this_run",
            "not_supported",
            "insufficient_evidence"
          ],
          "title": "Status",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "title",
        "explanation",
        "status",
        "priority",
        "evidence_refs"
      ],
      "title": "Finding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "alternatives": {
      "items": {
        "type": "string"
      },
      "title": "Alternatives",
      "type": "array"
    },
    "evidence_refs": {
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "hypotheses": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Hypotheses",
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "measured_facts": {
      "items": {
        "type": "string"
      },
      "title": "Measured Facts",
      "type": "array"
    },
    "mode": {
      "enum": [
        "live_model",
        "deterministic_fallback",
        "fixture"
      ],
      "title": "Mode",
      "type": "string"
    },
    "recommendations": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Recommendations",
      "type": "array"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "enum": [
        "live",
        "fixture",
        "replay"
      ],
      "title": "Source",
      "type": "string"
    }
  },
  "required": [
    "source",
    "run_id",
    "mode",
    "measured_facts",
    "hypotheses",
    "alternatives",
    "recommendations",
    "evidence_refs",
    "limitations"
  ],
  "title": "AnalysisResult",
  "type": "object"
}
